{
  "version": 1,
  "definitions": {
    "Empty": {
      "properties": {},
      "extra": false
    },
    "CommandAction": {
      "enum": [
        "open",
        "media_play",
        "media_pause",
        "media_next",
        "media_previous",
        "media_stop",
        "media_toggle",
        "deezer_start",
        "deezer_page",
        "deezer_search",
        "deezer_content",
        "deezer_reload",
        "deezer_smarttracklist"
      ]
    },
    "WindowsApplication": {
      "properties": {
        "appId": "string",
        "kind": {
          "enum": [
            "desktop",
            "store"
          ]
        },
        "icon": {
          "nullable": "string"
        },
        "launchArgument?": "string"
      },
      "extra": false
    },
    "InstalledApplication": {
      "properties": {
        "appId": "string",
        "kind": {
          "enum": [
            "desktop",
            "store"
          ]
        },
        "icon": {
          "nullable": "string"
        },
        "launchArgument?": "string",
        "name": "string"
      },
      "extra": false
    },
    "MediaTarget": {
      "properties": {
        "sourceAppId": "string",
        "deezer": "boolean"
      },
      "extra": false
    },
    "Application": {
      "properties": {
        "id": "string",
        "name": "string",
        "description": "string",
        "executable": "string",
        "arguments": {
          "array": "string",
          "max": 32
        },
        "aliases": {
          "array": "string",
          "max": 6
        },
        "enabled": "boolean",
        "windowsApp?": "WindowsApplication",
        "media?": "MediaTarget"
      },
      "extra": false
    },
    "ApplicationInput": {
      "properties": {
        "name": "string",
        "description": "string",
        "executable": "string",
        "arguments": {
          "array": "string",
          "max": 32
        },
        "aliases": {
          "array": "string",
          "max": 6
        },
        "enabled": "boolean",
        "windowsApp?": "WindowsApplication",
        "media?": "MediaTarget",
        "id?": "string"
      },
      "extra": false
    },
    "TestApplicationInput": {
      "properties": {
        "name": "string",
        "description": "string",
        "executable": "string",
        "arguments": {
          "array": "string",
          "max": 32
        },
        "aliases": {
          "array": "string",
          "max": 6
        },
        "enabled": "boolean",
        "windowsApp?": "WindowsApplication",
        "media?": "MediaTarget",
        "id?": "string",
        "input?": "string"
      },
      "extra": false
    },
    "CommandAlias": {
      "properties": {
        "id": "string",
        "phrase": "string",
        "applicationId": "string",
        "action": "CommandAction",
        "arguments?": {
          "record": "string"
        }
      },
      "extra": false
    },
    "CommandAliasInput": {
      "properties": {
        "phrase": "string",
        "applicationId": "string",
        "action": "CommandAction",
        "arguments?": {
          "record": "string"
        },
        "id?": "string"
      },
      "extra": false
    },
    "Config": {
      "properties": {
        "version": {
          "literal": 2
        },
        "applications": {
          "array": "Application",
          "max": 32
        },
        "language": "string",
        "autoExecute": "boolean",
        "confidenceThreshold": "number",
        "commandAliases?": {
          "array": "CommandAlias",
          "max": 64
        }
      },
      "extra": false
    },
    "Technical": {
      "properties": {
        "category": {
          "enum": [
            "model_failure",
            "microphone_denied",
            "microphone_missing",
            "target_missing",
            "action_failure",
            "request_timeout",
            "invalid_profile",
            "profile_io",
            "transport_unavailable",
            "transport_protocol",
            "transport_busy",
            "invalid_request",
            "sidecar_stderr",
            "diagnostic_io"
          ]
        }
      },
      "extra": false
    },
    "PamError": {
      "properties": {
        "code": {
          "enum": [
            "model_failure",
            "microphone_denied",
            "microphone_missing",
            "target_missing",
            "action_failure",
            "request_timeout",
            "invalid_profile",
            "profile_io",
            "transport_unavailable",
            "transport_protocol",
            "transport_busy",
            "invalid_request",
            "sidecar_stderr",
            "diagnostic_io"
          ]
        },
        "stage": {
          "enum": [
            "inference",
            "transcription",
            "microphone",
            "target",
            "transport",
            "queue",
            "profile",
            "validation",
            "sidecar",
            "diagnostics",
            "start",
            "write",
            "response",
            "host"
          ]
        },
        "requestId": "string",
        "retryable": "boolean",
        "message": "string",
        "technical": "Technical"
      },
      "extra": false
    },
    "ProfileSummary": {
      "properties": {
        "applications": {
          "array": "string",
          "max": 32
        },
        "formulations": "integer",
        "language": "string",
        "autoExecute": "boolean",
        "confidenceThreshold": "number"
      },
      "extra": false
    },
    "ImportPreview": {
      "properties": {
        "fingerprint": "string",
        "importFingerprint": "string",
        "summary": "ProfileSummary"
      },
      "extra": false
    },
    "ProfileReplacement": {
      "properties": {
        "config": "Config",
        "backupPath": "string"
      },
      "extra": false
    },
    "ProposalState": {
      "enum": [
        "pending",
        "expired",
        "invalidated",
        "consumed",
        "unknown"
      ]
    },
    "Proposal": {
      "properties": {
        "state": "ProposalState",
        "createdAt": {
          "nullable": "number"
        },
        "expiresAt": {
          "nullable": "number"
        },
        "reason": {
          "nullable": "string"
        }
      },
      "extra": false
    },
    "ProposalSnapshot": {
      "properties": {
        "id": "string",
        "state": "ProposalState",
        "createdAt": {
          "nullable": "number"
        },
        "expiresAt": {
          "nullable": "number"
        },
        "reason": {
          "nullable": "string"
        },
        "message?": "string"
      },
      "extra": false
    },
    "ActionCall": {
      "properties": {
        "name": "string",
        "arguments": {
          "record": "string"
        },
        "applicationId": "string",
        "applicationName": "string",
        "action?": "CommandAction",
        "actionLabel?": "string"
      },
      "extra": false
    },
    "ActionOutcome": {
      "enum": [
        "not_started",
        "performed",
        "failed",
        "unknown"
      ]
    },
    "ActionResult": {
      "properties": {
        "index?": "integer",
        "name?": "string",
        "applicationId?": "string",
        "applicationName": "string",
        "success": "boolean",
        "message": "string",
        "outcome?": "ActionOutcome",
        "error?": "PamError",
        "details?": "NativeLaunchResult"
      },
      "extra": false
    },
    "TurnStatus": {
      "enum": [
        "executed",
        "pending",
        "unsupported",
        "silence",
        "failed",
        "cancelled",
        "partial",
        "expired",
        "invalidated",
        "consumed"
      ]
    },
    "Turn": {
      "properties": {
        "id": "string",
        "transcript": "string",
        "language": "string",
        "confidence": {
          "nullable": "number"
        },
        "reasoning": "string",
        "durationMs": "number",
        "calls": {
          "array": "ActionCall",
          "max": 8
        },
        "results": {
          "array": "ActionResult",
          "max": 8
        },
        "status": "TurnStatus",
        "error?": "PamError",
        "proposal?": "Proposal",
        "message?": "string",
        "correctedFrom?": "string",
        "commandAliasId?": "string"
      },
      "extra": false
    },
    "MediaSession": {
      "properties": {
        "sourceAppId": "string",
        "title?": "string",
        "artist?": "string",
        "album?": "string",
        "playbackStatus?": "string",
        "capabilities?": {
          "properties": {
            "play": "boolean",
            "pause": "boolean",
            "next": "boolean",
            "previous": "boolean",
            "stop": "boolean",
            "toggle": "boolean"
          },
          "extra": false
        },
        "error?": "string"
      },
      "extra": false
    },
    "EngineStatus": {
      "properties": {
        "loaded": "boolean",
        "generation": "integer",
        "pid": "integer"
      },
      "extra": false
    },
    "ProfileBackup": {
      "properties": {
        "fingerprint": "string",
        "backupFingerprint": "string",
        "backupSummary": "ProfileSummary"
      },
      "extra": false
    },
    "ConfigError": {
      "properties": {
        "message": "string",
        "fingerprint?": "string",
        "recoverable": "boolean",
        "backupFingerprint?": "string",
        "backupSummary?": "ProfileSummary"
      },
      "extra": false
    },
    "RuntimeStatus": {
      "properties": {
        "ready": "boolean",
        "checks": {
          "array": {
            "properties": {
              "file": "string",
              "available": "boolean"
            },
            "extra": false
          },
          "max": 10000
        },
        "manifest": {
          "nullable": {
            "properties": {
              "node": "string",
              "npm": "string",
              "target": "string"
            },
            "extra": true
          }
        },
        "config": "Config",
        "configDirectory": "string",
        "engine": {
          "nullable": "EngineStatus"
        },
        "error?": "PamError",
        "applicationAvailability?": {
          "record": {
            "properties": {
              "available": "boolean",
              "reason?": "string"
            },
            "extra": false
          }
        },
        "configError?": "ConfigError",
        "profileBackup?": {
          "nullable": "ProfileBackup"
        },
        "temporaryCleanup?": {
          "properties": {
            "removed": "integer",
            "failed": "integer",
            "retained": "integer"
          },
          "extra": false
        },
        "proposals?": {
          "array": "ProposalSnapshot",
          "max": 10000
        },
        "desktop?": {
          "properties": {
            "shortcut": "string",
            "shortcutAvailable": "boolean",
            "shortcutError": "string",
            "closeToTray": "boolean"
          },
          "extra": false
        }
      },
      "extra": false
    },
    "Settings": {
      "properties": {
        "language": "string",
        "autoExecute": "boolean",
        "confidenceThreshold": "number"
      },
      "extra": false
    },
    "Id": {
      "properties": {
        "id": "string"
      },
      "extra": false
    },
    "ToggleApplication": {
      "properties": {
        "id": "string",
        "enabled": "boolean"
      },
      "extra": false
    },
    "TextInput": {
      "properties": {
        "text": "string"
      },
      "extra": false
    },
    "AudioInput": {
      "properties": {
        "audio": {
          "array": "byte",
          "max": 2000000
        }
      },
      "extra": false
    },
    "ActionInput": {
      "properties": {
        "applicationId": "string",
        "action": "CommandAction",
        "arguments?": {
          "record": "string"
        },
        "label?": "string"
      },
      "extra": false
    },
    "CorrectionInput": {
      "properties": {
        "id": "string",
        "text": "string",
        "applicationId?": "string",
        "action?": "CommandAction",
        "input?": "string",
        "arguments?": {
          "record": "string"
        },
        "saveAlias?": "boolean",
        "alias?": "string",
        "saveCommandAlias?": "boolean",
        "commandPhrase?": "string"
      },
      "extra": false
    },
    "RecoveryInput": {
      "properties": {
        "confirmed": {
          "literal": true
        },
        "fingerprint": "string",
        "restoreBackup?": "boolean",
        "backupFingerprint?": "string"
      },
      "extra": false
    },
    "ImportInput": {
      "properties": {
        "content": "string",
        "confirmed": {
          "literal": true
        },
        "fingerprint": "string",
        "importFingerprint": "string",
        "summary?": "ProfileSummary"
      },
      "extra": false
    },
    "DiagnosticInput": {
      "properties": {
        "code": {
          "enum": [
            "microphone_denied",
            "microphone_missing"
          ]
        }
      },
      "extra": false
    },
    "DiagnosticEvent": {
      "properties": {
        "time": "integer",
        "source": "string",
        "event": "string",
        "error": "PamError"
      },
      "extra": false
    },
    "DiagnosticExport": {
      "properties": {
        "format": {
          "literal": 1
        },
        "retentionDays": "integer",
        "maxLocalBytes": "integer",
        "events": {
          "array": "DiagnosticEvent",
          "max": 10000
        }
      },
      "extra": false
    },
    "NativeLaunchResult": {
      "properties": {
        "accepted": "boolean"
      },
      "extra": true
    },
    "DesktopAction": {
      "enum": [
        "hide",
        "quit",
        "listening",
        "idle"
      ]
    },
    "HostLaunchInput": {
      "properties": {
        "executable": "string",
        "arguments": {
          "array": "string",
          "max": 20
        },
        "id?": "string",
        "name?": "string",
        "description?": "string",
        "aliases?": {
          "array": "string",
          "max": 6
        },
        "enabled?": "boolean",
        "windowsApp?": "WindowsApplication",
        "media?": "MediaTarget"
      },
      "extra": false
    },
    "HostDeezerInput": {
      "properties": {
        "method": {
          "literal": "deezer_open"
        },
        "uri": "string"
      },
      "extra": false
    }
  },
  "methods": {
    "status": [
      "Empty",
      "RuntimeStatus"
    ],
    "export_diagnostics": [
      "Empty",
      "DiagnosticExport"
    ],
    "diagnostic_event": [
      "DiagnosticInput",
      "PamError"
    ],
    "recover_config": [
      "RecoveryInput",
      "ProfileReplacement"
    ],
    "export_config": [
      "Empty",
      "string"
    ],
    "preview_import": [
      {
        "properties": {
          "content": "string"
        },
        "extra": false
      },
      "ImportPreview"
    ],
    "import_config": [
      "ImportInput",
      "ProfileReplacement"
    ],
    "save_application": [
      "ApplicationInput",
      "Config"
    ],
    "set_application_enabled": [
      "ToggleApplication",
      "Config"
    ],
    "delete_application": [
      "Id",
      "Config"
    ],
    "settings": [
      "Settings",
      "Config"
    ],
    "process_text": [
      "TextInput",
      "Turn"
    ],
    "process_audio": [
      "AudioInput",
      "Turn"
    ],
    "confirm": [
      "Id",
      "Turn"
    ],
    "discard": [
      "Id",
      "Turn"
    ],
    "correct_request": [
      "CorrectionInput",
      "Turn"
    ],
    "restart_engine": [
      "Empty",
      "EngineStatus"
    ],
    "test_application": [
      "TestApplicationInput",
      "ActionResult"
    ],
    "media_sessions": [
      "Empty",
      {
        "array": "MediaSession",
        "max": 10000
      }
    ],
    "prepare_action": [
      "ActionInput",
      "Turn"
    ],
    "save_command_alias": [
      "CommandAliasInput",
      "Config"
    ],
    "delete_command_alias": [
      "Id",
      "Config"
    ],
    "desktop_action": [
      {
        "properties": {
          "action": "DesktopAction"
        },
        "extra": false
      },
      {
        "literal": null
      }
    ],
    "discover_applications": [
      "Empty",
      {
        "array": "InstalledApplication",
        "max": 10000
      }
    ]
  },
  "hostMethods": {
    "launch_application": "HostLaunchInput",
    "deezer_open": "HostDeezerInput"
  },
  "nativeOnly": [
    "desktop_action",
    "discover_applications",
    "export_diagnostics",
    "diagnostic_event"
  ]
}
