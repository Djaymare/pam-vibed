{
  "name": "pam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run prepare:runtime && vite",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test sidecar/*.test.cjs tests/*.test.mjs",
    "test:integration": "node scripts/smoke-runtime.mjs",
    "test:applications": "node scripts/smoke-applications.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "test:confidence": "node scripts/smoke-confidence.mjs",
    "test:deezer:routing": "node scripts/smoke-deezer-routing.mjs",
    "test:media:players": "node scripts/smoke-media.mjs --players",
    "test:media:deezer": "node scripts/smoke-media.mjs --deezer",
    "package:windows": "tauri build --target x86_64-pc-windows-msvc",
    "package:portable": "node scripts/package-portable.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "package:docker": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle && node scripts/package-portable.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5",
    "@tauri-apps/cli": "^2"
  }
}
