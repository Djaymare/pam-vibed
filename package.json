{
  "name": "pam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "lint": "eslint src/App.vue src/composables src/views sidecar/assistant.cjs sidecar/assistant --max-warnings 0",
    "format": "prettier --write src/App.vue src/composables src/views sidecar/assistant.cjs sidecar/assistant eslint.config.js .prettierrc.json",
    "format:check": "prettier --check src/App.vue src/composables src/views sidecar/assistant.cjs sidecar/assistant eslint.config.js .prettierrc.json",
    "check:development": "node scripts/check-development.mjs",
    "dev": "npm run check:development && vite",
    "dev:desktop": "npm run check:development && npm run prepare:runtime && vite",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "build": "npm run check:development && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "npm run check:development && tauri",
    "test": "node --test sidecar/*.test.cjs tests/*.test.mjs",
    "test:modals": "node scripts/test-modals.mjs",
    "test:contrast": "node scripts/test-contrast.mjs",
    "test:modals:build": "node scripts/build-modal-test-host.mjs",
    "test:integration": "node scripts/smoke-runtime.mjs",
    "test:processes": "node scripts/smoke-process-isolation.mjs",
    "test:applications": "node scripts/smoke-applications.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "test:confidence": "node scripts/smoke-confidence.mjs",
    "test:languages": "node scripts/smoke-languages.mjs",
    "test:execution": "node scripts/evaluate-execution.mjs heldout",
    "test:execution:calibration": "node scripts/evaluate-execution.mjs calibration",
    "test:deezer:routing": "node scripts/smoke-deezer-routing.mjs",
    "test:media:commands": "node scripts/smoke-media-commands.mjs",
    "test:media:refresh": "node scripts/test-media-refresh.mjs",
    "test:media:players": "node scripts/smoke-media.mjs --players",
    "test:media:deezer": "node scripts/smoke-media.mjs --deezer",
    "package:windows": "npm run check:development && tauri build --target x86_64-pc-windows-msvc -- --locked",
    "package:portable": "node scripts/package-portable.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "package:docker": "npm run check:development && tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --no-bundle -- --locked && node scripts/package-portable.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
