FROM node:24.21.0-bookworm-slim AS node
FROM rust:1.99.0-slim-bookworm

# Linux dependencies and Windows cross compiler stay inside the image.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clang lld llvm git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/pam
COPY rust-toolchain.toml ./
RUN rustup show \
    && cargo install --locked cargo-xwin --version 0.23.1
COPY package.json package-lock.json .npmrc ./
RUN npm ci
# .dockerignore excludes every host node_modules and generated/native cache.
COPY . .
RUN npm run check:development
CMD ["sh", "-c", "npm test && npm run build && npm run prepare:runtime && cargo xwin check --manifest-path src-tauri/Cargo.toml --locked --target x86_64-pc-windows-msvc"]
